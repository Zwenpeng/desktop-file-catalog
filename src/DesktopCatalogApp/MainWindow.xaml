<Window x:Class="DesktopCatalogApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="桌面文件管家" Height="820" Width="1320" MinHeight="650" MinWidth="920"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="桌面文件管家" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="只读扫描 · 本地运行 · 不上传文件 · 不提供删除操作" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="使用说明" Click="HelpButton_Click" AutomationProperties.Name="打开使用说明"/>
                <Button x:Name="ThemeButton" Content="深色模式" Click="ThemeButton_Click" AutomationProperties.Name="切换深色或浅色模式"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" Grid.Row="0" Grid.Column="0" Margin="0,0,10,0"
                         AutomationProperties.Name="要扫描的文件夹路径"/>
                <Button Grid.Row="0" Grid.Column="1" Content="选择文件夹" Click="ChooseFolderButton_Click"
                        AutomationProperties.Name="选择要扫描的文件夹"/>
                <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                    <Button x:Name="ScanButton" Content="开始扫描" Style="{StaticResource PrimaryButtonStyle}"
                            Click="ScanButton_Click" AutomationProperties.Name="开始只读扫描"/>
                    <Button x:Name="DuplicateButton" Content="精确查重" Click="DuplicateButton_Click" IsEnabled="False"
                            ToolTip="先按文件大小筛选候选，再计算 SHA-256；不会删除文件"/>
                    <Button x:Name="CancelButton" Content="取消任务" Click="CancelButton_Click" IsEnabled="False"/>
                    <Button x:Name="ExportCsvButton" Content="导出完整 CSV" Click="ExportCsvButton_Click" IsEnabled="False"
                            ToolTip="包含完整路径，适合自己分析，不建议直接发给他人"/>
                    <Button x:Name="ExportShareButton" Content="导出分享摘要" Click="ExportShareButton_Click" IsEnabled="False"
                            ToolTip="不包含完整路径和逐文件清单，适合分享"/>
                </WrapPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Columns="6" Margin="0,0,0,14">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="文件" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="FileCountText" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="目录" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="DirectoryCountText" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="逻辑容量" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="TotalBytesText" Text="0 B" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="重复组" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="DuplicateGroupText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="理论冗余" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="RedundantBytesText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                <StackPanel><TextBlock Text="本次变化" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="HistoryText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" Margin="0,0,10,0" TextChanged="Filter_Changed"
                         ToolTip="搜索文件名或相对路径" AutomationProperties.Name="搜索文件"/>
                <ComboBox x:Name="CategoryFilter" Grid.Column="1" Margin="0,0,10,0" SelectionChanged="Filter_Changed"
                          AutomationProperties.Name="按分类筛选"/>
                <ComboBox x:Name="DuplicateFilter" Grid.Column="2" Margin="0,0,10,0" SelectionChanged="Filter_Changed"
                          AutomationProperties.Name="按重复状态筛选"/>
                <CheckBox x:Name="HideNoiseCheck" Grid.Column="3" Content="隐藏依赖/缓存" VerticalAlignment="Center" Margin="0,0,16,0"
                          Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <TextBlock x:Name="VisibleCountText" Grid.Column="4" Text="尚未扫描" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <DataGrid x:Name="FileGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling" SelectionMode="Extended"
                      MouseDoubleClick="FileGrid_MouseDoubleClick" AutomationProperties.Name="扫描结果文件列表">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="打开文件" Click="OpenFileMenu_Click"/>
                        <MenuItem Header="打开所在文件夹" Click="OpenFolderMenu_Click"/>
                        <Separator/>
                        <MenuItem Header="复制完整路径" Click="CopyPathMenu_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="变化" Binding="{Binding ChangeText}" Width="80"/>
                    <DataGridTextColumn Header="重复" Binding="{Binding DuplicateText}" Width="110"/>
                    <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="110"/>
                    <DataGridTextColumn Header="文件名" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="所在目录（相对路径）" Binding="{Binding DirectoryPath}" Width="2*"/>
                    <DataGridTextColumn Header="扩展名" Binding="{Binding Extension}" Width="85"/>
                    <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="105"/>
                    <DataGridTextColumn Header="修改时间" Binding="{Binding ModifiedText}" Width="145"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <ProgressBar x:Name="TaskProgress" Width="160" Height="8" Margin="0,5,12,0" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText" Text="就绪：请选择文件夹并开始扫描。" Foreground="{DynamicResource MutedTextBrush}"/>
            </StackPanel>
            <Button x:Name="ShowErrorsButton" Grid.Column="1" Content="查看扫描边界" Click="ShowErrorsButton_Click" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
